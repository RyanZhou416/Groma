# Rust
/target/
**/*.rs.bk
*.pdb

# Cargo lock policy:
# - libraries: Cargo.lock is committed (workspace root) for reproducible CI
# - no per-crate lock files
!/Cargo.lock

# IDE / editors
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Local scratch / evidence
/tmp/
/scratch/
/Vectors/local/
*.log

# Fuzzing artifacts
/Fuzz/artifacts/
/Fuzz/corpus/
/Fuzz/target/
